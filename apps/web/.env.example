# Katha API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public URL of this web app, used for canonical/OpenGraph URLs and payment return URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: where the web server itself reaches the API for the sign-in route handlers under /api/auth (an
# internal address in a deployment). The browser keeps using NEXT_PUBLIC_API_URL. Whatever address this
# server calls from must be in the API's KATHA_FORWARDED_ALLOW_IPS, or every sign-in and refresh is
# rate-limited and IP-stamped as one client: this server.
API_INTERNAL_URL=
# Language prefixes the proxy routes (comma-separated codes). Leave empty to resolve them from the API at
# build time; a production build fails if the API is unreachable and this is not set.
NEXT_PUBLIC_LANGS=
# Media/CDN origins for HLS, covers, subtitles and avatars (comma-separated). Used for the image allow-list and CSP.
# List every origin media can arrive from, not just the object store. The API mints signed stream and
# subtitle URLs on KATHA_API_BASE_URL, which is often a different name for the API than the one the browser
# calls for JSON (a LAN address in development, a CDN or a separate media host in production). If it is
# missing here, CSP blocks the player and the covers, and the only symptom is a dead page with console
# violations.
NEXT_PUBLIC_MEDIA_ORIGINS=http://localhost:9000

# Firebase web app config (Project settings -> Your apps -> Web). Auth is disabled with a banner when these are missing.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Optional: extra hosts allowed to load dev assets (testing on a phone over the LAN)
NEXT_DEV_ALLOWED_ORIGINS=

# ads.txt body served at /ads.txt (use \n between lines). Empty serves an empty file.
NEXT_PUBLIC_ADS_TXT=
# IndexNow key. When set, /{key}.txt serves the key so Bing/Yandex can verify submissions.
NEXT_PUBLIC_INDEXNOW_KEY=
