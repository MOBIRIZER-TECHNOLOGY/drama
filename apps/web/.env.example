# Katha API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public URL of this web app, used for canonical/OpenGraph URLs and payment return URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Media/CDN origins for HLS, covers, subtitles and avatars (comma-separated). Used for the image allow-list and CSP.
NEXT_PUBLIC_MEDIA_ORIGINS=http://localhost:9000

# Firebase web app config (Project settings -> Your apps -> Web). Auth is disabled with a banner when these are missing.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Optional: extra hosts allowed to load dev assets (testing on a phone over the LAN)
NEXT_DEV_ALLOWED_ORIGINS=

# ads.txt body served at /ads.txt (use \n between lines). Empty serves an empty file.
NEXT_PUBLIC_ADS_TXT=
# IndexNow key. When set, /{key}.txt serves the key so Bing/Yandex can verify submissions.
NEXT_PUBLIC_INDEXNOW_KEY=
