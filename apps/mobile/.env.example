# Copy to .env (git-ignored via .env*.local or your own ignore rule) or set in EAS.
# Build profile: development | preview | production. app.config.ts picks the API host per profile; release builds
# refuse to start unless the API URL is https.
APP_ENV=development
# Optional override of the profile's API URL (10.0.2.2 reaches the host from the Android emulator).
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Firebase web app config (Project settings -> Your apps -> Web). Required for sign-in unless GET /v1/config
# returns `firebase` (which takes precedence when present).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Google sign-in via @react-native-google-signin/google-signin (OAuth client IDs from Google Cloud Console).
# The web client ID is what Firebase verifies. The Android client is matched by package name + SHA-1 in the
# All three come out of google-services.json / GoogleService-Info.plist, which the Firebase console hands
# you after Google sign-in is enabled (Authentication -> Sign-in method -> Google). Put those two files at
# apps/mobile/ — app.json points the native builds at them, and FCM push needs google-services.json.
#
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID is the *web* client (oauth_client with client_type 3), not the Android
# one sitting beside it: the native SDK uses it to mint an ID token Firebase will accept, and using the
# Android id instead fails at sign-in with an error that does not say so.
# GOOGLE_IOS_URL_SCHEME is the reversed iOS client id; build-time only, never in the bundle.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.PLACEHOLDER
