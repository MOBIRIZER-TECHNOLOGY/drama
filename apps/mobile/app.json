{
  "expo": {
    "name": "Katha",
    "slug": "katha",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "katha",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "ios": {
      "bundleIdentifier": "com.mobirizer.katha",
      "supportsTablet": false,
      "icon": "./assets/images/icon.png",
      "associatedDomains": [
        "applinks:katha.app"
      ],
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.mobirizer.katha",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "katha.app",
              "pathPrefix": "/s"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.CAMERA"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-video",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Katha uses your photos to set a profile picture.",
          "cameraPermission": false
        }
      ],
      "expo-apple-authentication",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/BricolageGrotesque-SemiBold.ttf",
            "./assets/fonts/BricolageGrotesque-Bold.ttf",
            "./assets/fonts/IBMPlexSans-Regular.ttf",
            "./assets/fonts/IBMPlexSans-Medium.ttf",
            "./assets/fonts/IBMPlexSans-SemiBold.ttf",
            "./assets/fonts/IBMPlexSans-Bold.ttf",
            "./assets/fonts/NotoSansDevanagari_400Regular.ttf",
            "./assets/fonts/NotoSansDevanagari_500Medium.ttf",
            "./assets/fonts/NotoSansDevanagari_600SemiBold.ttf",
            "./assets/fonts/NotoSansDevanagari_700Bold.ttf",
            "./assets/fonts/NotoSansTamil_400Regular.ttf",
            "./assets/fonts/NotoSansTamil_500Medium.ttf",
            "./assets/fonts/NotoSansTamil_600SemiBold.ttf",
            "./assets/fonts/NotoSansTamil_700Bold.ttf",
            "./assets/fonts/NotoSansTelugu_400Regular.ttf",
            "./assets/fonts/NotoSansTelugu_500Medium.ttf",
            "./assets/fonts/NotoSansTelugu_600SemiBold.ttf",
            "./assets/fonts/NotoSansTelugu_700Bold.ttf",
            "./assets/fonts/NotoSansBengali_400Regular.ttf",
            "./assets/fonts/NotoSansBengali_500Medium.ttf",
            "./assets/fonts/NotoSansBengali_600SemiBold.ttf",
            "./assets/fonts/NotoSansBengali_700Bold.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {}
    }
  }
}
