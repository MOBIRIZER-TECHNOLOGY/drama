# ---- services/api ----
KATHA_ENV=local
KATHA_DATABASE_URL=postgresql+asyncpg://katha:katha@localhost:5432/katha
KATHA_REDIS_URL=redis://localhost:6379/0
KATHA_JWT_SECRET=change-me-32-bytes-minimum-please-really
KATHA_JWT_ISSUER=katha
KATHA_ACCESS_TOKEN_TTL_SECONDS=900
KATHA_REFRESH_TOKEN_TTL_SECONDS=2592000

# Firebase Auth is the identity provider. Service account JSON path (never commit the file).
# --- media -------------------------------------------------------------------
# Public edge viewers fetch segments from, and the origin this service reads manifests from. They differ in
# production (edge vs bucket) and in development too, where a device's view of the host is not the host's own.
# The default is the MinIO bucket from infra/docker/compose.yaml; the self-hosted nginx edge is at the bottom.
KATHA_CDN_BASE_URL=http://localhost:9000/katha-media
KATHA_MEDIA_ORIGIN_URL=
# Where this API is reachable from a device. It goes inside HLS manifests as the AES key URL.
KATHA_API_BASE_URL=
# Signs playback URLs. Required in production. Mode `none` skips signing locally; `hmac` is the self-hosted
# edge's check (infra/nginx/media.conf).
KATHA_CDN_SIGNING_MODE=none
KATHA_MEDIA_SIGNING_KEY=
# Master secret for AES-128 HLS. Per-asset keys are derived from it and never stored, so a database dump
# decrypts nothing and rotating this rotates the whole catalogue. Required in production, and kept separate
# from the signing key on purpose: one value leaking should not do both jobs. The worker refuses to start
# with encryption on and this unset, in every environment, because a worker that silently fell back to the
# JWT secret would encrypt the catalogue under a key the API never hands out.
KATHA_MEDIA_ENCRYPTION_KEY=local-dev-media-encryption-key-change-me
# Proxy addresses whose X-Forwarded-For the API believes. Loopback by default; set to the load balancer's
# address (or CIDR) in a deployment, never "*", or every client can choose the IP its rate limit is keyed on.
# The web app's server also belongs here: its /api/auth route handlers call the API on the viewer's behalf.
KATHA_FORWARDED_ALLOW_IPS=127.0.0.1

KATHA_FIREBASE_PROJECT_ID=
KATHA_FIREBASE_SERVICE_ACCOUNT_FILE=

# Object storage (S3-compatible). MinIO values match infra/docker/compose.yaml.
KATHA_S3_ENDPOINT=http://localhost:9000
KATHA_S3_REGION=us-east-1
KATHA_S3_BUCKET=katha-media
KATHA_S3_ACCESS_KEY=katha
KATHA_S3_SECRET_KEY=katha-secret

# Payments (webhook-only). Leave blank locally.
KATHA_STRIPE_SECRET_KEY=
KATHA_STRIPE_WEBHOOK_SECRET=
KATHA_RAZORPAY_KEY_ID=
KATHA_RAZORPAY_KEY_SECRET=
KATHA_RAZORPAY_WEBHOOK_SECRET=
KATHA_REVENUECAT_WEBHOOK_SECRET=

# AI providers (services/ai)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# ---- apps/web, apps/admin ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- apps/mobile ----
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# ---- services/worker ----
KATHA_FFMPEG_BIN=ffmpeg
KATHA_FFPROBE_BIN=ffprobe
KATHA_MAX_JOBS=4

# ---- services/ai (KATHA_AI_ prefix) ----
# Providers: anthropic (default) | openai | google | groq | ollama
KATHA_AI_DEFAULT_PROVIDER=anthropic
KATHA_AI_ANTHROPIC_MODEL=claude-opus-5
# Self-hosted Ollama. No API key: reachability is the only requirement, so the base URL must be reachable from
# wherever the API and worker actually run, not just from a laptop. Point high-volume, low-stakes tasks at it
# per task rather than switching the default, e.g.
#   KATHA_AI_TASK_PROVIDERS={"subtitles":"ollama","translation":"ollama"}
KATHA_AI_OLLAMA_BASE_URL=http://localhost:11434
KATHA_AI_OLLAMA_MODEL=llama3.1:8b

# Public Firebase web config served to clients through /v1/config (optional; clients can also use their own env)
KATHA_FIREBASE_WEB_API_KEY=
KATHA_FIREBASE_WEB_AUTH_DOMAIN=
KATHA_FIREBASE_WEB_APP_ID=
KATHA_FIREBASE_WEB_MESSAGING_SENDER_ID=
KATHA_TURNSTILE_SITE_KEY=
KATHA_TURNSTILE_SECRET_KEY=
KATHA_REWARD_TIMEZONE=Asia/Kolkata
# Production requires: KATHA_ENV=production, a real KATHA_JWT_SECRET, KATHA_MEDIA_SIGNING_KEY,
# KATHA_MEDIA_ENCRYPTION_KEY and KATHA_CDN_SIGNING_MODE=hmac (the only signing mode).
KATHA_AI_TRANSCRIPTION_MODEL=whisper-1
# Embeddings (1024-d): openai text-embedding-3-small (default), voyage-3, google text-embedding-004,
# or ollama mxbai-embed-large (natively 1024-d, so no padding). Changing this changes `model_name()`, and
# vectors from different models are not comparable — re-embed the catalogue after switching.
KATHA_AI_EMBED_PROVIDER=openai
KATHA_AI_EMBED_OLLAMA_BASE_URL=http://localhost:11434
KATHA_AI_EMBED_OLLAMA_MODEL=mxbai-embed-large
VOYAGE_API_KEY=

# ---- tranche 1 ----
KATHA_SMTP_HOST=localhost
KATHA_SMTP_PORT=1025
KATHA_SMTP_FROM=Katha <no-reply@katha.app>
KATHA_ADMIN_BASE_URL=http://localhost:3001
KATHA_SITE_BASE_URL=http://localhost:3000
KATHA_SENTRY_DSN=
KATHA_OTLP_ENDPOINT=
KATHA_INDEXNOW_KEY=
# Self-hosted media edge (infra/nginx/media.conf): set cdn_base_url to the nginx host and signing mode to hmac
# KATHA_CDN_BASE_URL=http://localhost:8080/media
# KATHA_CDN_SIGNING_MODE=hmac

# Google Play Billing. Android purchases are verified against the Play Developer API before coins move, and
# refunds arrive as real-time developer notifications from a Pub/Sub push subscription. The subscription
# authenticates with an OIDC token minted for this audience (normally the public URL of /v1/webhooks/play)
# as this service account; both must be set or the route answers 503. The worker also reconciles voided
# purchases every six hours as a safety net, so a missed push is not a kept refund.
KATHA_GOOGLE_PLAY_PACKAGE_NAME=
KATHA_GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
KATHA_GOOGLE_PLAY_RTDN_AUDIENCE=
KATHA_GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=
